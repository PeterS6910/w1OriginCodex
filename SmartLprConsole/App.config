<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- URL SmartLPR REST API koncového bodu -->
    <add key="SmartLpr:BaseUrl" value="https://192.168.1.201:8080/" />
    <add key="SmartLpr:Username" value="admin" />
    <add key="SmartLpr:Password" value="admin" />
    <!-- Nastavenie na obídenie self-signed certifikátu pri testovaní -->
    <add key="SmartLpr:IgnoreSslErrors" value="true" />
    <!-- Voliteľne upravte timeout v sekundách -->
    <add key="SmartLpr:TimeoutSeconds" value="30" />
  </appSettings>
</configuration>
